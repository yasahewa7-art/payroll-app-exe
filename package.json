{
  "name": "rukman-payroll-offline",
  "version": "1.0.0",
  "description": "Rukman Engineering Payroll System (Offline Desktop)",
  "author": "NUVIA Labs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.nuvialabs.rukmanpayroll",
    "productName": "Rukman Payroll System",
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rukman Payroll System"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
